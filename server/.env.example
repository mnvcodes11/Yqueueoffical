PORT=5000
MONGO_URI=mongodb://localhost:27017/yqueue
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://yqueue.vercel.app,http://localhost:5173

# SMTP is server-only. Set these in local .env or Render Environment Variables.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=YQueue <your_sender@example.com>
EMAIL_ALLOW_TEST_TRANSPORT=false

# Password reset controls
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_WINDOW_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=3
RESET_SESSION_TTL_MINUTES=15

# Payment (Razorpay TEST mode keys - get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Secure single-use QR pickup tokens. Deliberately separate from JWT_SECRET
# so a compromised QR secret can never be used to forge login tokens.
QR_SECRET=replace_with_a_different_long_random_secret
QR_EXPIRES_IN=6h
