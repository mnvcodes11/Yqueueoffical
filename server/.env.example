PORT=5000
MONGO_URI=mongodb://localhost:27017/yqueue
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Payment (Razorpay TEST mode keys - get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# Secure single-use QR pickup tokens. Deliberately separate from JWT_SECRET
# so a compromised QR secret can never be used to forge login tokens.
QR_SECRET=replace_with_a_different_long_random_secret
QR_EXPIRES_IN=6h
